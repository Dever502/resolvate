# Installation settings. Each project's bot, group and integration credentials are
# configured in /console/; they are never inherited from this file.
# Required public HTTPS origin, without a path. Local development: http://localhost:8080
CONSOLE_ORIGIN=
# Preview of the new operator console at /console/next/ (built from frontend/).
# Keep it off in production until it replaces /console/.
CONSOLE_NEXT_ENABLED=false

DATA_DIR=./data
LOG_LEVEL=INFO
# The HTTP listener serves the console and all project APIs.
API_PORT=8080
# Requests allowed per project API credential in a fixed 60-second window.
API_REQUESTS_PER_MINUTE=6000
# Trust forwarding headers only from explicitly listed reverse proxies.
# API_TRUSTED_PROXY_IPS=

# PostgreSQL is required. Production Compose constructs the URLs and provisions
# distinct admin, migration and runtime roles. Use three different random,
# URL-safe passwords, at least 16 characters each.
POSTGRES_DB=resolvate
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

# For direct execution, provide runtime and migration URLs explicitly.
# Runtime must not be superuser/BYPASSRLS and must not own application tables.
# DATABASE_URL=postgresql+asyncpg://resolvate_runtime:<password>@localhost:5432/resolvate
# MIGRATION_DATABASE_URL=postgresql+asyncpg://resolvate_migrator:<password>@localhost:5432/resolvate
# Compose delegates migrations to its one-shot service and overrides this to false.
MIGRATIONS_AT_STARTUP=true

# Soft storage budgets per project. Reserve is measured against the shared disk.
# Active data is protected, so these are not strict disk quotas.
MEDIA_BUDGET_BYTES=21474836480
ARCHIVE_BUDGET_BYTES=2147483648
STORAGE_RESERVE_BYTES=3221225472

# No project-count limit. Capacity depends on traffic and available resources.
