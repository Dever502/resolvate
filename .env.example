# Required Telegram settings. SUPPORT_GROUP_ID must be a private Forum supergroup where
# the bot is an administrator with permission to manage topics.
SUPPORT_BOT_TOKEN=
SUPPORT_GROUP_ID=
# Comma-separated numeric Telegram IDs. Required unless API_ENABLED=true or CONSOLE_ORIGIN is set.
# Every listed admin can use all bot commands.
ADMIN_TELEGRAM_IDS=

# Runtime files such as Web media and heartbeat state are stored under DATA_DIR.
DATA_DIR=./data
# PostgreSQL is the only supported database. Compose builds both URLs from the role passwords
# below. For direct execution, DATABASE_URL is required and must use postgresql+asyncpg;
# MIGRATION_DATABASE_URL defaults to DATABASE_URL.
# DATABASE_URL=postgresql+asyncpg://resolvate_runtime:<runtime-password>@localhost:5432/resolvate
# MIGRATION_DATABASE_URL=
# Production Compose runs migrations in a one-shot service and forces this to false.
MIGRATIONS_AT_STARTUP=true
# Three distinct URL-safe random passwords, each at least 16 characters long, are required.
# Roles are fixed internally: postgres, resolvate_migrator and resolvate_runtime.
POSTGRES_DB=resolvate
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

# Runtime tuning
LOG_LEVEL=INFO
# Per-user message limits shared by Telegram and Web. Text and photo each count once.
USER_MESSAGES_PER_MINUTE=30
USER_MESSAGES_PER_HOUR=200
# Authenticated requests allowed per API token during a fixed 60-second window.
API_REQUESTS_PER_MINUTE=6000

# Topic rotation (AI integration is not complete).
# Operational alerts go to General in SUPPORT_GROUP_ID; no separate recipient is needed.
# Only newly journaled topics with a complete transcript are eligible. Cloud Bot API only.
# Files larger than 20 * 1024 * 1024 bytes are skipped with metadata, never downloaded.
# Turning this off stops new rotations; an already started cutover must still finish safely.
TOPIC_ROTATION_ENABLED=true
# Seconds after closing the session; reopening before cutover cancels the preparation.
TOPIC_ROTATION_DELAY_SECONDS=300
# Optional overrides; defaults without AI: 2500 messages, 250 topics, reserve 25.
# Cleanup starts at topic limit minus reserve and targets limit minus twice the reserve.
# TOPIC_ROTATION_MESSAGE_LIMIT=
# TOPIC_ROTATION_TOPIC_LIMIT=
# TOPIC_ROTATION_TOPIC_RESERVE=
# No AI provider is connected yet. Enabling AI defers rotation without a matching summary.
AI_ENABLED=false

# Archive lifecycle; age is measured from archiving, not compression or retries.
ARCHIVE_RETENTION_DAYS=60
ARCHIVE_MEDIA_COMPRESS_AFTER_DAYS=14
ARCHIVE_MEDIA_RETENTION_DAYS=30
# Soft budgets: pressure may remove old archived media, never active data or young text.
MEDIA_BUDGET_BYTES=21474836480
ARCHIVE_BUDGET_BYTES=2147483648
STORAGE_RESERVE_BYTES=3221225472

# Optional operator REST API. Compose exposes it only on 127.0.0.1:8080;
# use an HTTPS reverse proxy for external access.
API_ENABLED=false
# Enabled API tokens must contain at least 32 non-placeholder characters.
API_ADMIN_TOKEN=
# Unsafe: disables built-in API auth only with an advanced loopback bind.
API_UNSAFE_DISABLE_AUTH=false

# Optional operator panel at /console/, in the same process and on the same API port.
# Exact public HTTPS origin without a path; empty disables the panel.
# For local development only: http://localhost:8080
CONSOLE_ORIGIN=

# Optional server-to-server support API for a website backend. It shares the internal API
# endpoint, but uses a separate credential, request quota and route namespace.
WEB_API_ENABLED=false
# Must differ from API_ADMIN_TOKEN and contain at least 32 non-placeholder characters.
WEB_API_TOKEN=
# external_id (recommended): stable external_user_id identifies a client; email is mutable.
# email: normalized email identifies a client. Do not change after accepting Web messages.
WEB_IDENTITY_MODE=external_id

# Optional supported Remnawave 2.8.x integration. Remnawave remains the source of truth.
REMNAWAVE_ENABLED=false
# External integration URLs require HTTPS; HTTP is accepted only for localhost/loopback dev.
# Enabled Remnawave and webhook secrets must contain at least 32 non-placeholder characters.
# Panel origin without /api, for example https://panel.example.com.
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
# Controls direct Telegram delivery for /revokelink. A webhook event is always queued.
# true: Telegram + webhook event; false: webhook event only.
REMNAWAVE_REVOKE_LINK_TELEGRAM_NOTIFICATION=true
# Enables actual at-least-once webhook delivery to your product backend.
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
